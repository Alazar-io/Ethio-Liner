# Application
APP_NAME=EthioLiner
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ethioliner_db

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://10.0.2.2:8000"]
